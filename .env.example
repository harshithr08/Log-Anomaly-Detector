# Copy to .env to override the defaults in src/logad/common/config.py.
# The defaults already match docker-compose.yml, so this is optional.
LOGAD_REDIS_URL=redis://127.0.0.1:6379/0
LOGAD_DATABASE_URL=postgresql+asyncpg://logad:logad@127.0.0.1:5433/logad
# Protect the Break/Fix buttons (X-API-Key header); leave empty for a local demo
LOGAD_API_KEY=
